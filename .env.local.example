# ═══ รหัสล็อกเข้าเว็บ (สำคัญก่อน deploy!) ═══════════════════════════
# ตั้งรหัสนี้ = ต้องใส่รหัสก่อนเข้าดู dashboard (กันคนนอกเห็นข้อมูลจริง)
# เว้นว่าง = ไม่ล็อก (ใครมีลิงก์ก็เข้าได้ — ใช้เฉพาะตอน dev/demo)
DASHBOARD_PASSWORD=

# ═══ Meta / Facebook ═══════════════════════════════════════════════
# Long-lived System User access token (permission: ads_read, read_insights)
# business.facebook.com > Business settings > System users > Generate token
META_ACCESS_TOKEN=

# บัญชีโฆษณาที่จะดึง (id ตัวเลข ไม่ต้องมี act_ คั่นด้วย comma)
# ว่างไว้ = ดึงทุกบัญชีที่ token เข้าถึงได้อัตโนมัติ
META_AD_ACCOUNTS=

META_API_VERSION=v21.0

# ═══ TikTok (ใส่ทีหลังได้) ══════════════════════════════════════════
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_IDS=

# ═══ Supabase (ออปชัน — ใส่เมื่ออยากเก็บ cache + ประวัติ) ════════════
# ถ้าเว้นว่าง เว็บจะดึงสด (live) หรือใช้ demo โดยไม่ต้องมี Supabase
# 1) สมัคร supabase.com > New project
# 2) รัน SQL ใน supabase/migrations/0001_init.sql (SQL Editor)
# 3) เอา URL + service_role key มาใส่ที่นี่
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# จำนวนวันย้อนหลังที่ /api/sync ดึงมาทับทุกครั้ง
SYNC_DAYS=7

# ═══ Cron (สำหรับ auto-sync ทุก 5 นาที) ════════════════════════════
# สุ่มสตริงยาว ๆ กันคนนอกยิง /api/sync
# ตั้งใน cron-job.org: URL = https://<โดเมน>/api/sync?key=<CRON_SECRET> ทุก 5 นาที
CRON_SECRET=
